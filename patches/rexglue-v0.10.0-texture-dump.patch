+namespace {
+
+// Raw guest bytes + descriptor for one texture, consumed by texview/.
+// All integers are little-endian.
+struct RetexHeader {
+  char magic[8];  // "RETEX01\0"
+  uint32_t width, height, depth_or_array;
+  uint32_t dimension;  // xenos::DataDimension
+  uint32_t format;     // xenos::TextureFormat
+  uint32_t tiled, packed_mips;
+  uint32_t pitch;  // base_pitch_texels_div_32 from the fetch constant
+  uint32_t mip_max_level, has_base, endianness;
+  uint32_t base_size_bytes, mips_size_bytes;
+};
+
+struct TextureDumpState {
+  std::mutex mutex;
+  std::unordered_set<uint64_t> dumped_hashes;
+  uint32_t file_count = 0;
+  bool dir_ready = false;
+  static constexpr uint32_t kMaxFiles = 1024;
+  static constexpr uint32_t kMaxBytesPerTexture = 64u << 20;
+};
+
+TextureDumpState& GetTextureDumpState() {
+  static TextureDumpState state;
+  return state;
+}
+
