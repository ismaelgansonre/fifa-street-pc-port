+void TextureCache::MaybeDumpGuestTexture(Texture& texture, bool load_base, bool load_mips) {
+  const std::string dump_dir(REXCVAR_GET(vulkan_dump_textures));
+  if (dump_dir.empty()) {
+    return;
+  }
+  const TextureKey key = texture.key();
+  // Render targets and non-2D textures are out of scope for the offline viewer.
+  if (key.scaled_resolve || key.dimension != xenos::DataDimension::k2DOrStacked) {
+    return;
+  }
+  const bool has_base = key.base_page != 0 && load_base;
+  const bool has_mips = key.mip_page != 0 && load_mips;
+  if (!has_base && !has_mips) {
+    return;
+  }
+  uint32_t base_size = has_base ? texture.GetGuestBaseSize() : 0;
+  uint32_t mips_size = has_mips ? texture.GetGuestMipsSize() : 0;
+  TextureDumpState& state = GetTextureDumpState();
+  if (base_size > TextureDumpState::kMaxBytesPerTexture ||
+      mips_size > TextureDumpState::kMaxBytesPerTexture) {
+    return;
+  }
+  // Identity of the guest allocation (first upload wins; menu textures are static).
+  uint64_t hash = 14695981039346656037ull;
+  const auto mix = [&hash](uint32_t v) {
+    for (int i = 0; i < 4; ++i) hash = (hash ^ uint8_t(v >> (8 * i))) * 1099511628211ull;
+  };
+  mix(key.base_page);
+  mix(key.mip_page);
+  mix(key.width_minus_1);
+  mix(key.height_minus_1);
+  mix(uint32_t(key.format));
+  mix(key.pitch);
+  mix((uint32_t(key.tiled) << 1) | uint32_t(key.packed_mips));
+  uint32_t file_index = 0;
+  {
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (!state.dir_ready) {
+      std::error_code error;
+      std::filesystem::create_directories(dump_dir, error);
+      state.dir_ready = true;
+    }
+    if (state.file_count >= TextureDumpState::kMaxFiles) {
+      return;
+    }
+    if (!state.dumped_hashes.insert(hash).second) {
+      return;
+    }
+    file_index = state.file_count++;
+  }
+  RetexHeader header = {};
+  std::memcpy(header.magic, "RETEX01", 8);
+  header.width = key.GetWidth();
+  header.height = key.GetHeight();
+  header.depth_or_array = key.GetDepthOrArraySize();
+  header.dimension = uint32_t(key.dimension);
+  header.format = uint32_t(key.format);
+  header.tiled = key.tiled ? 1 : 0;
+  header.packed_mips = key.packed_mips ? 1 : 0;
+  header.pitch = key.pitch;
+  header.mip_max_level = key.mip_max_level;
+  header.has_base = has_base ? 1 : 0;
+  header.endianness = uint32_t(key.endianness);
+  header.base_size_bytes = base_size;
+  header.mips_size_bytes = mips_size;
+  std::vector<uint8_t> base_bytes(base_size), mips_bytes(mips_size);
+  if (base_size) {
+    std::memcpy(base_bytes.data(),
+                shared_memory().TranslateResidentGuestPhysical(key.base_page << 12), base_size);
+  }
+  if (mips_size) {
+    std::memcpy(mips_bytes.data(),
+                shared_memory().TranslateResidentGuestPhysical(key.mip_page << 12), mips_size);
+  }
+  char name[128];
+  std::snprintf(name, sizeof(name), "tex_%04u_%ux%u_fmt%u_%s%s_p%08X.retex", file_index,
+                header.width, header.height, header.format, has_base ? "b" : "",
+                has_mips ? "m" : "", key.base_page << 12);
+  std::ofstream file(std::filesystem::path(dump_dir) / name, std::ios::binary);
+  if (!file) {
+    REXGPU_ERROR("Texture dump: cannot open {} for writing", name);
+    return;
+  }
+  file.write(reinterpret_cast<const char*>(&header), sizeof(header));
+  if (base_size) file.write(reinterpret_cast<const char*>(base_bytes.data()), base_size);
+  if (mips_size) file.write(reinterpret_cast<const char*>(mips_bytes.data()), mips_size);
+}
