@@ -28,6 +29,28 @@ bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution mo
   Close();
   int flags = (mode == SymbolResolution::kImmediate) ? RTLD_NOW : RTLD_LAZY;
   handle_ = dlopen(path.c_str(), flags);
+  if (!handle_ && path.is_relative()) {
+    // Windows LoadLibrary appends ".dll" and searches the executable folder
+    // for extension-less module names; dlopen does neither. Recompiled module
+    // registrations rely on that behavior, so retry beside the executable with
+    // the platform suffix, both unprefixed and with the "lib" prefix CMake
+    // gives module libraries on this platform.
+    std::filesystem::path candidate = path;
+    if (!candidate.has_extension()) {
+#if defined(__APPLE__)
+      candidate.replace_extension(".dylib");
+#else
+      candidate.replace_extension(".so");
+#endif
+    }
+    const auto exe_dir = rex::filesystem::GetExecutableFolder();
+    handle_ = dlopen((exe_dir / candidate).c_str(), flags);
+    if (!handle_) {
+      std::filesystem::path lib_prefixed =
+          candidate.parent_path() / ("lib" + candidate.filename().string());
+      handle_ = dlopen((exe_dir / lib_prefixed).c_str(), flags);
+    }
+  }
   return handle_ != nullptr;
