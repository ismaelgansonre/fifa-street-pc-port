@@ -4606,6 +4747,18 @@ bool VulkanCommandProcessor::IssueCopy_ReadbackResolvePath() {
                                    (constants.scale_x > 1 || constants.scale_y > 1))
                                       ? 1u
                                       : 0u;
+    // Color render-to-texture copies (player face portraits) are averaged; depth and other formats stay
+    // point-sampled, an average of their bits would be meaningless.
+    {
+      const auto copy_control = register_file_->Get<reg::RB_COPY_CONTROL>();
+      const auto dest_format = copy_dest_info.copy_dest_format;
+      constants.average = (REXCVAR_GET(readback_resolve_average_color) && pixel_size_log2 == 2 &&
+                           copy_control.copy_src_select != 4 &&
+                           (dest_format == xenos::ColorFormat::k_8_8_8_8 ||
+                            dest_format == xenos::ColorFormat::k_8_8_8_8_A))
+                              ? 1u
+                              : 0u;
+    }
     deferred_command_buffer_.CmdVkPushConstants(resolve_downscale_pipeline_layout_,
                                                 VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(constants),
                                                 &constants);
