+  uint xe_downscale_average;
 };
 
 // Source buffer (scaled resolve data)
@@ -146,8 +148,20 @@ void main() {
       }
       break;
     }
-    case 2u: {  // 32-bit - direct copy
-      xe_resolve_dest.data[dst_offset] = xe_resolve_source.data[src_offset];
+    case 2u: {  // 32-bit - direct copy, or the per-channel block average for 8:8:8:8 color
+      if (xe_downscale_average != 0u && scale_xy > 1u) {
+        uint block_base = (xe_downscale_source_offset_bytes + tile_index * tile_size_scaled +
+                           pixel_index * pixel_size * scale_xy) >> 2u;
+        uvec4 sum = uvec4(0u);
+        for (uint s = 0u; s < scale_xy; ++s) {
+          uint texel = xe_resolve_source.data[block_base + s];
+          sum += uvec4(texel & 0xFFu, (texel >> 8u) & 0xFFu, (texel >> 16u) & 0xFFu, texel >> 24u);
+        }
+        sum = (sum + uvec4(scale_xy >> 1u)) / uvec4(scale_xy);
+        xe_resolve_dest.data[dst_offset] = sum.x | (sum.y << 8u) | (sum.z << 16u) | (sum.w << 24u);
+      } else {
+        xe_resolve_dest.data[dst_offset] = xe_resolve_source.data[src_offset];
+      }
       break;
     }
     case 3u: {  // 64-bit - direct copy (2 uints)
