+CommandProcessor::SomeDecision CommandProcessor::DecideSomeRefresh(uint64_t key, uint32_t address,
+                                                                   uint32_t length,
+                                                                   uint64_t frame) {
+  some_frame_.store(frame, std::memory_order_relaxed);
+  SomeDecision decision;
+  std::lock_guard<std::mutex> lock(some_mutex_);
+  SomeRangeInfo& info = some_ranges_[key];
+  info.address = address;
+  info.length = length;
+  ++info.calls;
+  // Frame cadence of this range. Several resolves in one frame say nothing, so they keep the streak.
+  if (info.last_frame != 0 && frame > info.last_frame) {
+    if (frame - info.last_frame <= 2) {
+      ++info.streak;
+    } else {
+      info.streak = 0;
+    }
+  }
+  info.last_frame = frame;
+  if (info.first_frame == 0) {
+    info.first_frame = frame;
+  }
+  // Only a range resolved on at least half of all frames since it was first seen counts as
+  // "every frame"; one that is merely resolved in bursts keeps being refreshed.
+  const uint64_t age = frame - info.first_frame;
+  const bool every_frame = info.streak >= 8 && age >= 1200 && uint64_t(info.calls) * 2 >= age;
+  const int32_t interval = REXCVAR_GET(readback_some_refresh_interval);
+  const int32_t below = REXCVAR_GET(readback_some_refresh_below);
+  if (REXCVAR_GET(readback_some_adaptive) && frame <= info.hot_until_frame) {
+    decision.refresh = true;
+  } else if (REXCVAR_GET(readback_some_refresh_sporadic) && !every_frame) {
+    decision.refresh = true;
+    decision.sync = REXCVAR_GET(readback_some_sporadic_sync);
+  } else if (interval > 0 && info.calls % uint32_t(interval) == 0) {
+    decision.refresh = true;
+  } else if (below > 0 && length < uint32_t(below)) {
+    decision.refresh = true;
+  }
+  ++some_decisions_;
+  if (REXCVAR_GET(readback_some_log) && frame >= some_last_table_frame_ + 600) {
+    some_last_table_frame_ = frame;
+    std::vector<std::pair<uint64_t, const SomeRangeInfo*>> rows;
+    for (const auto& [row_key, row] : some_ranges_) {
+      rows.emplace_back(row_key, &row);
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) {
+      return uint64_t(a.second->length) * a.second->calls >
+             uint64_t(b.second->length) * b.second->calls;
+    });
+    REXGPU_INFO("[SOMETABLE] frame={} ranges={} (sorted by bytes resolved)", frame, rows.size());
+    for (size_t i = 0; i < rows.size() && i < 40; ++i) {
+      const SomeRangeInfo& row = *rows[i].second;
+      REXGPU_INFO(
+          "[SOMETABLE] {:08X}+{:X} ({:.2f} MB) calls={} skipped={} refreshed={} streak={} hits={} "
+          "stale={}",
+          row.address, row.length, row.length / 1048576.0, row.calls, row.skipped, row.refreshed,
+          row.streak, row.hits, row.stale);
+    }
+  }
+  // After skipped resolves the double-buffer slots hold old data, so the first refresh must read
+  // the slot that was just written.
+  const int32_t sync_below = REXCVAR_GET(readback_some_sync_below);
+  if (decision.refresh && sync_below > 0 && length < uint32_t(sync_below)) {
+    decision.sync = true;
+  }
+  decision.sync = decision.sync || (decision.refresh && info.stale);
+  const std::string skip_addrs = REXCVAR_GET(readback_some_skip_addrs);
+  const std::string sync_addrs = REXCVAR_GET(readback_some_sync_addrs);
+  if (!skip_addrs.empty() && AddressInList(skip_addrs, address)) {
+    decision = SomeDecision{};
+  } else if (!sync_addrs.empty() && AddressInList(sync_addrs, address)) {
+    decision.refresh = true;
+    decision.sync = true;
+  }
+  return decision;
+}
+
+void CommandProcessor::NoteSomeRangeSkipped(uint64_t key) {
+  std::lock_guard<std::mutex> lock(some_mutex_);
+  SomeRangeInfo& info = some_ranges_[key];
+  ++info.skipped;
+  info.stale = true;
+}
+
+void CommandProcessor::NoteSomeRangeRefreshed(uint64_t key) {
+  std::lock_guard<std::mutex> lock(some_mutex_);
+  SomeRangeInfo& info = some_ranges_[key];
+  ++info.refreshed;
+  info.stale = false;
+}
+
+void CommandProcessor::OnGuestInvalidatedRange(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  const uint64_t end = uint64_t(start) + length;
+  const uint64_t frame = some_frame_.load(std::memory_order_relaxed);
+  const bool log = REXCVAR_GET(readback_some_log);
+  const uint64_t hot_frames = uint64_t(REXCVAR_GET(readback_some_hot_frames));
+  std::lock_guard<std::mutex> lock(some_mutex_);
+  for (auto& [key, info] : some_ranges_) {
+    if (uint64_t(info.address) >= end || uint64_t(info.address) + info.length <= start) {
+      continue;
+    }
+    ++info.hits;
+    if (info.stale) {
+      info.hot_until_frame = frame + hot_frames;
+    }
+    if (log && some_hit_logs_ < 200) {
+      ++some_hit_logs_;
+      REXGPU_INFO(
+          "[SOME] guest invalidated {:08X}+{:X} over range {:08X}+{:X} (key {:016X}, calls={} "
+          "skipped={} refreshed={} stale={} hits={})",
+          start, length, info.address, info.length, key, info.calls, info.skipped, info.refreshed,
+          info.stale, info.hits);
+    }
+  }
+}
