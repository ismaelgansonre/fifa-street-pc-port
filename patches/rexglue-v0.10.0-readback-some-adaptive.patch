+namespace {
+// Parses a comma separated list of hex addresses; cached by string value.
+bool AddressInList(const std::string& list, uint32_t address) {
+  size_t pos = 0;
+  while (pos < list.size()) {
+    size_t end = list.find(',', pos);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    if (end > pos) {
+      const uint32_t value =
+          uint32_t(std::strtoul(list.substr(pos, end - pos).c_str(), nullptr, 16));
+      if (value == address) {
+        return true;
+      }
+    }
+    pos = end + 1;
+  }
+  return false;
+}
